# Copy to .env (ignored by Git), fill locally, and export with:
# set -a; source experiments/agent_dataset_discovery/.env; set +a

# Host only: benchmark tracking and prompt lookup. Existing host login also works.
# Optional tracking target override (run_benchmark.py already defaults to this):
# LAMIN_CURRENT_INSTANCE=laminlabs/lamindb-benchmarks
LAMIN_API_KEY=''

# Default codex_auth: chatgpt uses CODEX_HOME/auth.json or ~/.codex/auth.json.
# Optional override if your ChatGPT login file is elsewhere:
# DISCOVERY_CODEX_AUTH_FILE=/absolute/path/to/auth.json
# Only for codex_auth: api_key (separate API billing):
# DISCOVERY_CODEX_API_KEY=''

# Lamin condition: these two values plus your Codex login are all this case needs.
# The reader needs access to the corpus instance and any storage it must read.
# AWS credentials below are never forwarded to the Lamin container.
DISCOVERY_LAMIN_INSTANCE=laminlabs/lamindb-load-test
DISCOVERY_LAMIN_API_KEY=''

# S3 condition only: scoped reader credentials, not your host's general AWS credentials.
DISCOVERY_S3_URI='s3://YOUR_BUCKET/YOUR_CORPUS_PREFIX/'
DISCOVERY_AWS_ACCESS_KEY_ID=''
DISCOVERY_AWS_SECRET_ACCESS_KEY=''
DISCOVERY_AWS_SESSION_TOKEN=''
DISCOVERY_AWS_REGION='eu-west-1'
