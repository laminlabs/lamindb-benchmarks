{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCorpus",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["YOUR_CORPUS_PREFIX/*"]}}
    },
    {
      "Sid": "DenyListingOutsideCorpus",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": {"StringNotLike": {"s3:prefix": ["YOUR_CORPUS_PREFIX/*"]}}
    },
    {
      "Sid": "ReadCorpusObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::YOUR_BUCKET/YOUR_CORPUS_PREFIX/*"
    },
    {
      "Sid": "GetCorpusBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::YOUR_BUCKET"
    }
  ]
}
